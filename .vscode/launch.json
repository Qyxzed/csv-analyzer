{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Windows — WinLibs GCC + GDB",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:\\winlibs\\mingw64\\bin\\gdb.exe",
      "preLaunchTask": "Build C (Windows / WinLibs GCC)",
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}